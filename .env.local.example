# Gmail típico: host smtp.gmail.com | porta 587 | secure false
# Use senha de app do Google (não a senha normal da conta).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noryxteam@gmail.com
MAIL_PASSWORD=
MAIL_FROM_NAME=Noryx
MAIL_FROM_EMAIL=noryxteam@gmail.com
