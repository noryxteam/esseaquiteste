# Servidor
NODE_ENV=development
PORT=3333
API_PREFIX=/api/v1

# Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/norax?schema=public"

# JWT (estrutura preparada)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Upload (estrutura preparada — sem storage externo)
UPLOAD_MAX_SIZE_MB=50
UPLOAD_LOCAL_PATH=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000

# URLs públicas (links do e-mail Sim/Não)
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://127.0.0.1:3333/api/v1

# E-mail SMTP (Gmail) — senha de app
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Norax
MAIL_FROM_EMAIL=
